{
  "name": "palliroute-frontend",
  "private": true,
  "workspaces": [
    "web",
    "pwa",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @palliroute/web",
    "dev:pwa": "npm run dev -w @palliroute/pwa",
    "build:web": "npm run build -w @palliroute/web",
    "build:pwa": "npm run build -w @palliroute/pwa",
    "build": "npm run build -w @palliroute/web && npm run build -w @palliroute/pwa",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w @palliroute/web && npm run typecheck -w @palliroute/pwa",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@react-google-maps/api": "^2.20.6",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "react": "^19.2.7",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@emotion/babel-plugin": "^11.13.5",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.1",
    "vite": "^6.2.6",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
