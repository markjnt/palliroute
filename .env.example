# Stage: prod | dev  (Projekt-, Container-, Traefik-Router- und Image-Tags)
STAGE=prod

# App / Domain
WEB_DOMAIN=web.deinedomain.de
PWA_DOMAIN=pwa.deinedomain.de

# Backend – CORS
CORS_ORIGINS=https://web.deinedomain.de,https://pwa.deinedomain.de,http://localhost:3000,http://localhost:3001

# PostgreSQL (Produktion / Docker)
POSTGRES_DB=palliroute
POSTGRES_USER=palliroute
POSTGRES_PASSWORD=change-me-strong-password

# Backend-Konfiguration
SECRET_KEY=your_secret_key_here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
APLANO_API_KEY=your-aplano-api-key-here
# Optional: ausführliche INFEASIBLE-Diagnostik in API-Antwort/Logs
AUTO_PLAN_VERBOSE_INFEASIBLE=false

# Scheduler
AUTO_IMPORT_ENABLED=true
AUTO_IMPORT_TIMES=08:00,12:30,16:00

# Pfade für Excel-Import / Export
EXCEL_IMPORT_PATH=/path/to/excel_import
EXPORT_PALLIDOC_PATH=/path/to/Export_PalliDoc

# Feiertage (NRW, feiertage-api.de)
# HOLIDAY_API_BASE_URL=https://feiertage-api.de/api/
HOLIDAY_STATE=NW

# --- Dev-Beispiel (eigene Datei ~/palliroute-dev/.env) ---
# STAGE=dev
# WEB_DOMAIN=dev.web.deinedomain.de
# PWA_DOMAIN=dev.pwa.deinedomain.de
# CORS_ORIGINS=https://dev.web.deinedomain.de,https://dev.pwa.deinedomain.de
# AUTO_IMPORT_ENABLED=false
# SECRET_KEY=...   # neu generieren
# POSTGRES_PASSWORD=...  # neu generieren
