server {
    listen 3001;
    server_name localhost;

    # Runtime auth config from container env (same envsubst pattern as web INTERNAL_API_KEY)
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        return 200 'window.__PALLIROUTE_CONFIG__={"azureTenantId":"${AZURE_TENANT_ID}","azureClientId":"${AZURE_CLIENT_ID}"};';
    }

    # PWA-Updates: index.html und Service Worker nicht cachen
    location = /index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location ~ ^/(sw\.js|workbox-.*\.js|dev-sw\.js)$ {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        index index.html index.htm;
    }

    location /api {
        proxy_pass http://backend-api:9000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
